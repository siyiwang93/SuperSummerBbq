@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="form-page">
    <div class="container-fluid px-lg-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Admin Dashboard</h1>
                <p class="text-muted mb-0">Super Summer BBQ 2026 — registration overview</p>
            </div>
            <form asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
            </form>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-pill">
                    <div class="stat-value">@Model.TotalActive</div>
                    <div class="small text-muted">Active</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-pill">
                    <div class="stat-value">@Model.ShuttleToCount</div>
                    <div class="small text-muted">Shuttle To</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-pill">
                    <div class="stat-value">@Model.ShuttleBackCount</div>
                    <div class="small text-muted">Shuttle Back</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-pill">
                    <div class="stat-value">@Model.GuestCount</div>
                    <div class="small text-muted">With Guest</div>
                </div>
            </div>
        </div>

        @if (Model.DepartmentBreakdown.Any())
        {
            <div class="card section-card mb-4">
                <div class="card-header">Registrations by Department</div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var dept in Model.DepartmentBreakdown)
                        {
                            <div class="col-auto">
                                <span class="badge bg-secondary">@dept.Key: @dept.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="card section-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>All Active Registrations (@Model.TotalActive)</span>
                @if (Model.TotalCancelled > 0)
                {
                    <span class="small opacity-75">@Model.TotalCancelled cancelled total</span>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Employee ID</th>
                                <th>Department</th>
                                <th>Shuttle</th>
                                <th>Guest</th>
                                <th>Registered</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Registrations.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No registrations yet.</td>
                                </tr>
                            }
                            @foreach (var r in Model.Registrations)
                            {
                                <tr>
                                    <td>@r.FirstName @r.LastName</td>
                                    <td>@r.EmployeeId</td>
                                    <td>@r.Department</td>
                                    <td>
                                        @if (r.ShuttleToVenue) { <span class="badge badge-shuttle">To</span> }
                                        @if (r.ShuttleBack) { <span class="badge badge-shuttle">Back</span> }
                                        @if (!r.ShuttleToVenue && !r.ShuttleBack) { <span class="text-muted">—</span> }
                                    </td>
                                    <td>@(r.BringingGuest ? "Yes" : "No")</td>
                                    <td class="small">@r.RegisteredAt.ToLocalTime().ToString("g")</td>
                                    <td>
                                        <form asp-action="CancelRegistration" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel registration for @r.FirstName @r.LastName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>