@model AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<section class="form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="form-card">
                    <h1 class="h3 mb-1"><i class="bi bi-shield-lock me-2"></i>Admin Access</h1>
                    <p class="text-muted mb-4">Enter the admin access key to view registrations and manage the event.</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="AccessKey" class="form-label"></label>
                            <input asp-for="AccessKey" class="form-control" />
                            <span asp-validation-for="AccessKey" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-bbq-primary w-100">Sign In</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}