<section class="bbq-hero-stitch">
    <div class="bbq-hero-media" aria-hidden="true">
        <img src="@heroImage" alt="" />
    </div>
    <div class="bbq-hero-content">
        <h1>@Model.Event.Name</h1>
        <div id="countdown" class="countdown-row" data-event-date="@Model.EventDateIso">
            <div class="countdown-glass">
                <span class="countdown-value" id="cd-days">00</span>
                <span class="countdown-label">Days</span>
            </div>
            <div class="countdown-glass">
                <span class="countdown-value" id="cd-hours">00</span>
                <span class="countdown-label">Hours</span>
            </div>
            <div class="countdown-glass">
                <span class="countdown-value" id="cd-minutes">00</span>
                <span class="countdown-label">Mins</span>
            </div>
            <div class="countdown-glass">
                <span class="countdown-value" id="cd-seconds">00</span>
                <span class="countdown-label">Sec</span>
            </div>
        </div>
        <p id="countdown-live" class="text-white fw-bold d-none mb-3">The BBQ is today!</p>
        <div class="hero-meta-row">
            <span><i class="bi bi-calendar-event me-1"></i>@Model.Event.Date.ToString("MMMM d, yyyy") · @Model.Event.Date.ToString("h:mm tt")</span>
            <span class="meta-divider">|</span>
            <span><i class="bi bi-geo-alt me-1"></i>@Model.Event.Location</span>
        </div>
        <p class="hero-tagline">
            Join us for an afternoon of Al Fresco Joy — smoky flavors, team connection, and ice-cold refreshments at BV Campus.
        </p>
        <div class="hero-actions">
            <a asp-controller="Registrations" asp-action="Register" class="btn btn-bbq-primary btn-lg">
                <i class="bi bi-balloon-heart me-1"></i> Join the Party
            </a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="feast" class="btn btn-bbq-secondary btn-lg">
                View The Feast
            </a>
        </div>
        <p class="hero-stats mb-0">
            <i class="bi bi-people me-1"></i> @Model.TotalRegistrations employee@(Model.TotalRegistrations == 1 ? "" : "s") registered so far
        </p>
    </div>
</section>

<section class="bbq-section bbq-section-full" id="feast">
    <div class="bbq-section-inner">
        <h2 class="bbq-section-title">The Main Event: The Feast</h2>
        <p class="bbq-section-subtitle">A sensory journey through the best of summer grilling, from flame-kissed burgers to sun-ripened sides.</p>
        <div class="bento-grid">
            <article class="bento-card bento-large">
                <img src="@feastBurger" alt="Gourmet Burger" loading="lazy" />
                <div class="bento-overlay bento-overlay-strong">
                    <div class="bento-chips">
                        <span class="bento-chip bento-chip-primary">Bestseller</span>
                        <span class="bento-chip bento-chip-secondary">Spicy Option</span>
                    </div>
                    <h3>The Sizzle Master Burger</h3>
                    <p>Hand-pressed wagyu, aged cheddar, and our secret &quot;Habanero Honey&quot; BBQ sauce on a toasted brioche.</p>
                </div>
            </article>
            <article class="bento-card bento-small">
                <img src="@feastCorn" alt="Grilled Corn" loading="lazy" />
                <div class="bento-overlay">
                    <h3>Golden Street Corn</h3>
                    <p>Lime crema, cotija, and a dash of smoked paprika.</p>
                </div>
            </article>
            <article class="bento-card bento-small">
                <img src="@feastLemonade" alt="Cold Lemonade" loading="lazy" />
                <div class="bento-overlay">
                    <h3>Hand-Squeezed Refreshment</h3>
                    <p>Mint-infused lemonade with fresh Sicilian lemons.</p>
                </div>
            </article>
            <article class="bento-card bento-wide">
                <img src="@feastTacos" alt="Chef Gabriel's Street Tacos" loading="lazy" />
                <div class="bento-overlay bento-overlay-strong">
                    <div class="bento-chips">
                        <span class="bento-chip bento-chip-tertiary">Chef's Special</span>
                    </div>
                    <h3>Chef Gabriel's Street Tacos</h3>
                    <p>Authentic slow-smoked carnitas with fresh cilantro, onions, and a zingy lime squeeze.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="bbq-section bbq-section-alt bbq-section-full" id="pitmasters">
    <div class="bbq-section-inner">
        <h2 class="bbq-section-title">Meet the Pitmasters</h2>
        <p class="bbq-section-subtitle">The culinary artists behind this summer's most anticipated flavors.</p>
        <div class="pitmasters-grid">
            <article class="pitmaster-card">
                <div class="pitmaster-photo">
                    <img src="@pitmasterMayda" alt="Chef Mayda" loading="lazy" />
                </div>
                <div class="pitmaster-body">
                    <div class="pitmaster-eyebrow">Venezuelan Fire</div>
                    <h3>Chef Mayda</h3>
                    <p>Bringing the heat with authentic Arepas and Venezuelan BBQ traditions.</p>
                </div>
            </article>
            <article class="pitmaster-card">
                <div class="pitmaster-photo">
                    <img src="@pitmasterGabriel" alt="Chef Gabriel" loading="lazy" />
                </div>
                <div class="pitmaster-body">
                    <div class="pitmaster-eyebrow">Mexican Tacos</div>
                    <h3>Chef Gabriel</h3>
                    <p>Master of the grill, serving up hand-pressed tortillas and slow-smoked carnitas.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="bbq-section" id="agenda">
    <h2 class="bbq-section-title">Event Agenda</h2>
    <p class="bbq-section-subtitle">Your afternoon at Super Summer BBQ 2026 — from check-in to shuttle departures.</p>
    <div class="agenda-stitch-list">
        <article class="agenda-stitch-item">
            <div class="agenda-stitch-icon"><i class="bi bi-door-open"></i></div>
            <div>
                <div class="agenda-stitch-time">11:00 AM</div>
                <h4>Doors Open &amp; Check-in</h4>
                <p>Pick up your name tag and grab a welcome drink.</p>
            </div>
        </article>
        <article class="agenda-stitch-item">
            <div class="agenda-stitch-icon"><i class="bi bi-megaphone"></i></div>
            <div>
                <div class="agenda-stitch-time">11:30 AM</div>
                <h4>Welcome Remarks</h4>
                <p>Leadership kick-off and team shout-outs.</p>
            </div>
        </article>
        <article class="agenda-stitch-item">
            <div class="agenda-stitch-icon"><i class="bi bi-fire"></i></div>
            <div>
                <div class="agenda-stitch-time">12:00 PM</div>
                <h4>Lunch Served</h4>
                <p>Burgers, veggie options, sides, and refreshments for all.</p>
            </div>
        </article>
        <article class="agenda-stitch-item">
            <div class="agenda-stitch-icon"><i class="bi bi-trophy"></i></div>
            <div>
                <div class="agenda-stitch-time">1:00 PM</div>
                <h4>Games &amp; Activities</h4>
                <p>Cornhole, relay races, and department trivia.</p>
            </div>
        </article>
        <article class="agenda-stitch-item">
            <div class="agenda-stitch-icon"><i class="bi bi-bus-front"></i></div>
            <div>
                <div class="agenda-stitch-time">3:00 PM</div>
                <h4>Closing &amp; Shuttle Departures</h4>
                <p>Shuttle service returns to main campus stops.</p>
            </div>
        </article>
    </div>
</section>

<section class="bbq-section" id="faq">
    <h2 class="bbq-section-title">Frequently Asked Questions</h2>
    <p class="bbq-section-subtitle">Everything you need to know before you RSVP.</p>
    <div class="bbq-faq-wrap">
        <div class="accordion" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        Is the event free?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Yes! This is a free annual internal company event for all employees.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        Can I bring a guest?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Yes — indicate on the registration form if you are bringing a guest so we can plan food and seating.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        How do I get to the venue?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Shuttle service is available to and from the venue. Select your shuttle preferences when registering, or drive and park on-site.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                        How do I update or cancel my registration?
                    </button>
                </h2>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Use <strong>My Registration</strong> in the menu and sign in with your Employee ID and work email.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                        What about dietary restrictions?
                    </button>
                </h2>
                <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        List any dietary preferences or allergies on the registration form. Our catering team will accommodate vegetarian, vegan, gluten-free, and other needs.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        initBbqCountdown("@Model.EventDateIso");
        initPageScroll();
    </script>
}