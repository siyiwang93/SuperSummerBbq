@{
    ViewData["Title"] = "FAQ";
}

<section class="bbq-content-page">
    <div class="bbq-content-page-inner">
        <section class="bbq-section" id="faq">
            <h2 class="bbq-section-title">Frequently Asked Questions</h2>
            <p class="bbq-section-subtitle">Everything you need to know before you RSVP.</p>
            <div class="bbq-faq-wrap">
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                Is the event free?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes! This is a free annual internal company event for all employees.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                Can I bring a guest?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes — indicate on the registration form if you are bringing a guest so we can plan food and seating.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                How do I get to the venue?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Shuttle service is available to and from the venue. Select your shuttle preferences when registering, or drive and park on-site.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                How do I update or cancel my registration?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Use <strong>My Registration</strong> in the menu and sign in with your Employee ID and work email.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                What about dietary restrictions?
                            </button>
                        </h2>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                List any dietary preferences or allergies on the registration form. Our catering team will accommodate vegetarian, vegan, gluten-free, and other needs.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</section>