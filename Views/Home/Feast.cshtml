<section class="bbq-content-page bbq-feast-page">
    <div class="bbq-feast-page-inner">
        <section class="bbq-section" id="feast">
            <h2 class="bbq-section-title">The Main Event: The Feast</h2>
            <p class="bbq-section-subtitle">A sensory journey through the best of summer grilling, from flame-kissed burgers to sun-ripened sides.</p>
            <div class="bento-grid">
                <article class="bento-card bento-large">
                    <img src="@feastBurger" alt="Gourmet Burger" loading="lazy" />
                    <div class="bento-overlay bento-overlay-strong">
                        <div class="bento-chips">
                            <span class="bento-chip bento-chip-primary">Bestseller</span>
                            <span class="bento-chip bento-chip-secondary">Spicy Option</span>
                        </div>
                        <h3>The Sizzle Master Burger</h3>
                        <p>Hand-pressed wagyu, aged cheddar, and our secret &quot;Habanero Honey&quot; BBQ sauce on a toasted brioche.</p>
                    </div>
                </article>
                <article class="bento-card bento-small">
                    <img src="@feastCorn" alt="Grilled Corn" loading="lazy" />
                    <div class="bento-overlay">
                        <h3>Golden Street Corn</h3>
                        <p>Lime crema, cotija, and a dash of smoked paprika.</p>
                    </div>
                </article>
                <article class="bento-card bento-small">
                    <img src="@feastLemonade" alt="Cold Lemonade" loading="lazy" />
                    <div class="bento-overlay">
                        <h3>Hand-Squeezed Refreshment</h3>
                        <p>Mint-infused lemonade with fresh Sicilian lemons.</p>
                    </div>
                </article>
                <article class="bento-card bento-wide">
                    <img src="@feastTacos" alt="Chef Gabriel's Street Tacos" loading="lazy" />
                    <div class="bento-overlay bento-overlay-strong">
                        <div class="bento-chips">
                            <span class="bento-chip bento-chip-tertiary">Chef's Special</span>
                        </div>
                        <h3>Chef Gabriel's Street Tacos</h3>
                        <p>Authentic slow-smoked carnitas with fresh cilantro, onions, and a zingy lime squeeze.</p>
                    </div>
                </article>
            </div>
        </section>
    </div>

    <section class="bbq-section bbq-section-alt bbq-section-full" id="pitmasters">
        <div class="bbq-section-inner">
            <h2 class="bbq-section-title">Meet the Pitmasters</h2>
            <p class="bbq-section-subtitle">The culinary artists behind this summer's most anticipated flavors.</p>
            <div class="pitmasters-grid">
                <article class="pitmaster-card">
                    <div class="pitmaster-photo">
                        <img src="@pitmasterMayda" alt="Chef Mayda" loading="lazy" />
                    </div>
                    <div class="pitmaster-body">
                        <div class="pitmaster-eyebrow">Venezuelan Fire</div>
                        <h3>Chef Mayda</h3>
                        <p>Bringing the heat with authentic Arepas and Venezuelan BBQ traditions.</p>
                    </div>
                </article>
                <article class="pitmaster-card">
                    <div class="pitmaster-photo">
                        <img src="@pitmasterGabriel" alt="Chef Gabriel" loading="lazy" />
                    </div>
                    <div class="pitmaster-body">
                        <div class="pitmaster-eyebrow">Mexican Tacos</div>
                        <h3>Chef Gabriel</h3>
                        <p>Master of the grill, serving up hand-pressed tortillas and slow-smoked carnitas.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>
</section>