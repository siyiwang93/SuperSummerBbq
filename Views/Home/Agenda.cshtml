@{
    ViewData["Title"] = "Agenda";
}

<section class="bbq-content-page">
    <div class="bbq-content-page-inner">
        <section class="bbq-section" id="agenda">
            <h2 class="bbq-section-title">Event Agenda</h2>
            <p class="bbq-section-subtitle">Your afternoon at Super Summer BBQ 2026 — from check-in to shuttle departures.</p>
            <div class="agenda-stitch-list">
                <article class="agenda-stitch-item">
                    <div class="agenda-stitch-icon"><i class="bi bi-door-open"></i></div>
                    <div>
                        <div class="agenda-stitch-time">11:00 AM</div>
                        <h4>Doors Open &amp; Check-in</h4>
                        <p>Pick up your name tag and grab a welcome drink.</p>
                    </div>
                </article>
                <article class="agenda-stitch-item">
                    <div class="agenda-stitch-icon"><i class="bi bi-megaphone"></i></div>
                    <div>
                        <div class="agenda-stitch-time">11:30 AM</div>
                        <h4>Welcome Remarks</h4>
                        <p>Leadership kick-off and team shout-outs.</p>
                    </div>
                </article>
                <article class="agenda-stitch-item">
                    <div class="agenda-stitch-icon"><i class="bi bi-fire"></i></div>
                    <div>
                        <div class="agenda-stitch-time">12:00 PM</div>
                        <h4>Lunch Served</h4>
                        <p>Burgers, veggie options, sides, and refreshments for all.</p>
                    </div>
                </article>
                <article class="agenda-stitch-item">
                    <div class="agenda-stitch-icon"><i class="bi bi-trophy"></i></div>
                    <div>
                        <div class="agenda-stitch-time">1:00 PM</div>
                        <h4>Games &amp; Activities</h4>
                        <p>Cornhole, relay races, and department trivia.</p>
                    </div>
                </article>
                <article class="agenda-stitch-item">
                    <div class="agenda-stitch-icon"><i class="bi bi-bus-front"></i></div>
                    <div>
                        <div class="agenda-stitch-time">3:00 PM</div>
                        <h4>Closing &amp; Shuttle Departures</h4>
                        <p>Shuttle service returns to main campus stops.</p>
                    </div>
                </article>
            </div>
        </section>
    </div>
</section>