@model RegistrationFormViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="form-card">
                    <h1 class="h3 mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Register for the BBQ</h1>
                    <p class="text-muted mb-4">Complete the form below to reserve your spot at Super Summer BBQ 2026.</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <partial name="_RegistrationForm" model="Model" />
                        <div class="mt-4 d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-bbq-primary">
                                <i class="bi bi-check-lg me-1"></i> Submit Registration
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}