@model EmailConfirmationViewModel
@{
    ViewData["Title"] = "Registration Confirmed";
    var r = Model.Registration;
    var dietary = string.IsNullOrWhiteSpace(r.DietaryPreferences) ? "None specified" : r.DietaryPreferences;
}

<canvas id="bbq-confetti-canvas" class="bbq-confetti-canvas" aria-hidden="true"></canvas>

<section class="bbq-confirm-page">
    <div class="bbq-confirm-shell">
        <article class="bbq-confirm-stitch-card">
            <div class="bbq-confirm-celebration" aria-hidden="true">
                <i class="bi bi-balloon-heart-fill"></i>
            </div>
            <p class="bbq-confirm-eyebrow">You&apos;re on the guest list</p>
            <h1 class="bbq-confirm-title">See You at the Grill!</h1>
            <p class="bbq-confirm-lead">
                Thanks, <strong>@r.FirstName</strong> — your RSVP for <strong>@Model.Event.Name</strong> is confirmed.
            </p>

            <div class="bbq-confirm-event-panel">
                <div class="bbq-confirm-event-row">
                    <span class="bbq-confirm-event-icon"><i class="bi bi-calendar-event"></i></span>
                    <div>
                        <div class="bbq-confirm-event-label">When</div>
                        <div class="bbq-confirm-event-value">@Model.Event.Date.ToString("dddd, MMMM d, yyyy") · @Model.Event.Date.ToString("h:mm tt")</div>
                    </div>
                </div>
                <div class="bbq-confirm-event-row">
                    <span class="bbq-confirm-event-icon"><i class="bi bi-geo-alt"></i></span>
                    <div>
                        <div class="bbq-confirm-event-label">Where</div>
                        <div class="bbq-confirm-event-value">@Model.Event.Location</div>
                    </div>
                </div>
            </div>

            <div class="bbq-confirm-details-panel">
                <h2 class="bbq-confirm-details-heading">Your details</h2>
                <dl class="bbq-confirm-details">
                    <div>
                        <dt>Name</dt>
                        <dd>@r.FirstName @r.LastName</dd>
                    </div>
                    <div>
                        <dt>Employee ID</dt>
                        <dd>@r.EmployeeId</dd>
                    </div>
                    <div>
                        <dt>Department</dt>
                        <dd>@r.Department</dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>@r.Email</dd>
                    </div>
                    <div>
                        <dt>Dietary</dt>
                        <dd>@dietary</dd>
                    </div>
                    <div>
                        <dt>Shuttle to venue</dt>
                        <dd>@(r.ShuttleToVenue ? "Yes" : "No")</dd>
                    </div>
                    <div>
                        <dt>Shuttle back</dt>
                        <dd>@(r.ShuttleBack ? "Yes" : "No")</dd>
                    </div>
                    <div>
                        <dt>Guest</dt>
                        <dd>@(r.BringingGuest ? "Yes" : "No")</dd>
                    </div>
                    <div class="bbq-confirm-details-wide">
                        <dt>Confirmation #</dt>
                        <dd><span class="bbq-confirm-code">@r.ConfirmationToken.ToString("N")[..8].ToUpper()</span></dd>
                    </div>
                </dl>
            </div>

            <div class="bbq-confirm-email-panel">
                <div class="bbq-confirm-email-header">
                    <i class="bi bi-envelope-check"></i>
                    <div>
                        <h2 class="bbq-confirm-email-title">Confirmation email</h2>
                        <p class="bbq-confirm-email-note">
                            Demo mode: message sent to <strong>@r.Email</strong> (logged on server).
                        </p>
                    </div>
                </div>
                <pre class="bbq-email-preview">@Model.SimulatedEmailBody</pre>
            </div>

            <div class="bbq-form-actions bbq-confirm-actions">
                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-bbq-primary">
                    <i class="bi bi-person-badge me-1"></i> View My Registration
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-bbq-outline">Back to Home</a>
            </div>
        </article>
    </div>
</section>

@section Scripts {
    <script src="~/js/bbq-confetti.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof launchBbqConfetti === "function") {
                launchBbqConfetti(4500);
            }
        });
    </script>
}