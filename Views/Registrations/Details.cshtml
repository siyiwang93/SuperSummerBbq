@model Registration
@{
    ViewData["Title"] = "My Registration";
}

<section class="form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
                        <div>
                            <h1 class="h3 mb-1">Your Registration</h1>
                            <p class="text-muted mb-0">Confirmation #@Model.ConfirmationToken.ToString("N")[..8].ToUpper()</p>
                        </div>
                        <span class="badge bg-success fs-6">Active</span>
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-4">Employee ID</dt>
                        <dd class="col-sm-8">@Model.EmployeeId</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@Model.Department</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Dietary Preferences</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.DietaryPreferences) ? "None specified" : Model.DietaryPreferences)</dd>

                        <dt class="col-sm-4">Shuttle to venue</dt>
                        <dd class="col-sm-8">
                            @if (Model.ShuttleToVenue) { <span class="badge badge-shuttle">Yes</span> } else { <span class="text-muted">No</span> }
                        </dd>

                        <dt class="col-sm-4">Shuttle back</dt>
                        <dd class="col-sm-8">
                            @if (Model.ShuttleBack) { <span class="badge badge-shuttle">Yes</span> } else { <span class="text-muted">No</span> }
                        </dd>

                        <dt class="col-sm-4">Bringing a guest</dt>
                        <dd class="col-sm-8">
                            @if (Model.BringingGuest) { <span class="badge badge-guest">Yes</span> } else { <span class="text-muted">No</span> }
                        </dd>

                        <dt class="col-sm-4">Registered</dt>
                        <dd class="col-sm-8">@Model.RegisteredAt.ToLocalTime().ToString("f")</dd>
                    </dl>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-bbq-primary">
                            <i class="bi bi-pencil me-1"></i> Edit Registration
                        </a>
                        <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-x-circle me-1"></i> Cancel Registration
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>