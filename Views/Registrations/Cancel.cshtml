@model Registration
@{
    ViewData["Title"] = "Cancel Registration";
}

<section class="form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-card text-center">
                    <i class="bi bi-exclamation-triangle text-warning display-4 mb-3"></i>
                    <h1 class="h3 mb-3">Cancel Registration?</h1>
                    <p class="text-muted">
                        Are you sure you want to cancel your registration for
                        <strong>@Model.FirstName @Model.LastName</strong> (Employee ID: @Model.EmployeeId)?
                        This action cannot be undone from your account — you would need to register again.
                    </p>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center flex-wrap mt-4">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Yes, Cancel My Registration</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Keep Registration</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>